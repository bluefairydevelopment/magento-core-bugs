<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <!--
        Fix: Magento\Theme\Ui\Component\Design\Config\DataProvider uses
        $connection->getTableName() which does NOT apply the table prefix in
        Magento 2.4.x. Replaced with $resourceConnection->getTableName() which
        correctly prepends the configured table prefix.
        See: BlueFairy/CoreBugs README.md — Bug #1
    -->
    <preference for="Magento\Theme\Ui\Component\Design\Config\DataProvider"
                type="BlueFairy\CoreBugs\Ui\Component\Design\Config\DataProvider"/>
    <!--
        Fix: Magento\Downloadable\Observer\SetLinkStatusObserver uses
        $item->getId() as an array key without a null guard in three of its
        four branches (only the canceled/closed/complete branch guards it).
        $item->getId() is null there during normal order placement on this
        Magento/PHP combination, and PHP 8.1+'s null-array-offset deprecation
        gets promoted to a fatal Exception by Magento's own error handler,
        aborting every order that contains a downloadable item.
        See: BlueFairy/CoreBugs README.md — Bug #2, M2MAP-190
    -->
    <preference for="Magento\Downloadable\Observer\SetLinkStatusObserver"
                type="BlueFairy\CoreBugs\Observer\Downloadable\SetLinkStatusObserver"/>
    <!--
        Fix: Magento\Framework\App\PageCache\Kernel::process() calls
        $response->setNoCacheHeaders() BEFORE the private getPreparedData()
        snapshots $response->getHeaders()->toArray() for the full-page-cache
        save — both calls read/write the SAME response object, so every
        saved cache entry permanently gets the no-store headers meant only
        for the live cache-miss response, and buildResponse() faithfully
        replays that no-store snapshot on every later cache HIT. Confirmed
        as stock Magento 2.4.9 core behaviour on a from-scratch install with
        zero custom modules and no custom theme.
        See: BlueFairy/CoreBugs README.md — Bug #3,
        https://github.com/magento/magento2/issues/41643
    -->
    <preference for="Magento\Framework\App\PageCache\Kernel"
                type="BlueFairy\CoreBugs\App\PageCache\Kernel"/>
</config>
